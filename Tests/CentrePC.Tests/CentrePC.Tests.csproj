<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests automatiques de Centre PC (lancés par GitHub à chaque envoi, ou à la main : dotnet test Tests\CentrePC.Tests).
    Le code de Core\ est compilé directement ici (l'appli est un exe autonome, qu'un projet de tests ne peut pas référencer).
  -->
  <PropertyGroup>
    <!-- Version de Windows visée : donne accès à la reconnaissance de texte (Windows.Media.Ocr) et à la lecture des PDF (Windows.Data.Pdf) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>CentrePC.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\GlobalUsings.cs" Link="GlobalUsings.cs" />
    <EmbeddedResource Include="..\..\Scripts\maj.ps1" LogicalName="maj.ps1" Link="maj.ps1" />
    <EmbeddedResource Include="..\..\CONDITIONS.md" LogicalName="CONDITIONS.md" Link="CONDITIONS.md" />
    <EmbeddedResource Include="..\..\CONFIDENTIALITE.md" LogicalName="CONFIDENTIALITE.md" Link="CONFIDENTIALITE.md" />
    <EmbeddedResource Include="..\..\USAGE-PROFESSIONNEL.md" LogicalName="USAGE-PROFESSIONNEL.md" Link="USAGE-PROFESSIONNEL.md" />
    <EmbeddedResource Include="..\..\Catalogue\noms.gz" LogicalName="noms.gz" Link="noms.gz" Condition="Exists('..\..\Catalogue\noms.gz')" />
    <None Include="..\..\Scripts\maj.ps1" Link="Scripts\maj.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CentrePC</AssemblyName>
    <RootNamespace>CentrePC</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>Centre PC</Product>
    <Authors>Kevin Hardy</Authors>
    <Company>Kevin Hardy</Company>
    <Copyright>© 2026 Kevin Hardy</Copyright>
    <Description>Applications, bureau et mises à jour de Windows en un seul endroit.</Description>
    <Version>1.2.2</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Le projet de tests a son propre .csproj : ses fichiers ne font pas partie de l'appli -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scripts\maj.ps1" LogicalName="maj.ps1" />
    <Resource Include="app.ico" />
  </ItemGroup>
</Project>

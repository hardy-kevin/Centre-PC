                                    <Border Height="1" Background="{StaticResource Line}" Margin="0,16"/>
                                    <TextBlock x:Name="AboutText" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Button Style="{StaticResource BaseButton}" Click="OpenLog_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6"
                                            ToolTip="Journal local des erreurs (aucune donnée n'est transmise), utile pour diagnostiquer un problème">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9F9;" Style="{StaticResource Glyph}" FontSize="13"/>
                                            <TextBlock Text="Ouvrir le journal" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource BaseButton}" Click="ExportDiagnostic_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6"
                                            ToolTip="Fichier listant chaque application, sa catégorie et ce qui a permis de la classer (rien n'est transmis)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="13"/>
                                            <TextBlock Text="Exporter le diagnostic du classement" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource BaseButton}" Content="Revoir la présentation" Click="ShowWelcome_Click" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource BaseButton}" Content="Ouvrir le dossier des réglages" Click="OpenDataDir_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================= Éditeur de thème ======================= -->
                    <Grid x:Name="ThemeEditor" Grid.RowSpan="2" Visibility="Collapsed" Background="#D90B0B10">
                        <Border Width="720" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="30,24">
                            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <TextBlock x:Name="ThemeEditorTitle" Text="Modifier la catégorie" Style="{StaticResource SectionTitle}" FontSize="20"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="CancelTheme_Click"/>
                                </Grid>
                                <TextBlock Text="NOM" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,6"/>
                                <TextBox x:Name="ThemeNameBox" Style="{StaticResource SearchBox}" Tag="Nom de la catégorie"/>
                                <TextBlock Text="COULEUR" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,16,0,6"/>
                                <WrapPanel x:Name="ThemeColors"/>
                                <TextBlock Text="SYMBOLE" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <WrapPanel x:Name="ThemeGlyphs"/>
                                <TextBlock Text="MOTS-CLÉS (un par ligne : nom d'application, éditeur, dossier…)" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBox x:Name="ThemeKeywordsBox" Height="190" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                         Background="#0E0E13" Foreground="{StaticResource Text}" CaretBrush="{StaticResource Text}" BorderBrush="{StaticResource Line}"
                                         Padding="10" FontSize="13"/>
                                <Grid Margin="0,18,0,0">
                                    <Button x:Name="DeleteThemeButton" Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Click="DeleteTheme_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13"/>
                                            <TextBlock Text="Supprimer cette catégorie" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BaseButton}" Content="Annuler" Click="CancelTheme_Click" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource AccentButton}" Content="Enregistrer" Click="SaveTheme_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ======================= Assistant de tri ======================= -->
                    <Grid x:Name="SorterOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D90B0B10">
                        <Border Width="820" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="30,24">
                            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Trier les applications" Style="{StaticResource SectionTitle}" FontSize="20"/>
                                        <TextBlock Text="Un clic (ou la touche du chiffre correspondant) classe l'application et passe à la suivante." Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock x:Name="SorterProgress" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="CloseSorter_Click" ToolTip="Terminer (Échap)"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="SorterBar" Height="4" Margin="0,14,0,20" Foreground="{StaticResource Accent}" Background="{StaticResource Surface2}" BorderThickness="0"/>

                                <Border Background="{StaticResource Surface2}" CornerRadius="14" Padding="20,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="64" Height="64">
                                            <Border x:Name="SorterInitialBox" CornerRadius="14" Background="{StaticResource Accent}">
                                                <TextBlock x:Name="SorterInitial" FontSize="28" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image x:Name="SorterIcon" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SorterName" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SorterHint" Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <WrapPanel x:Name="SorterThemes" Margin="0,18,0,8"/>

                                <Grid Margin="0,10,0,0">
                                    <Button x:Name="SorterBackButton" Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Click="SorterBack_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="13"/>
                                            <TextBlock Text="Précédent" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BaseButton}" Click="SorterSkip_Click" ToolTip="Touche Espace">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="SorterSkipGlyph" Text="&#xE893;" Style="{StaticResource Glyph}" FontSize="13"/>
                                                <TextBlock x:Name="SorterSkipText" Text="Laisser dans Autres" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ======================= Rangement des fichiers ======================= -->
                    <Grid x:Name="DocSorterOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D90B0B10">
                        <Border Width="900" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="30,24">
                            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Ranger les éléments un par un" Style="{StaticResource SectionTitle}" FontSize="20"/>
                                        <TextBlock Text="Un clic (ou la touche du chiffre correspondant) range le fichier dans le dossier choisi et passe au suivant." Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock x:Name="DocSorterProgress" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="DocSorterClose_Click" ToolTip="Terminer (Échap)"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="DocSorterBar" Height="4" Margin="0,14,0,20" Foreground="{StaticResource Accent}" Background="{StaticResource Surface2}" BorderThickness="0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72" Height="72" CornerRadius="14" Background="{StaticResource Surface2}">
                                        <Image x:Name="DocSorterIcon" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DocSorterName" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DocSorterInfo" Style="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="DocSorterSuggest" Foreground="{StaticResource Accent}" FontSize="12.5" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource BaseButton}" Click="DocSorterOpen_Click" VerticalAlignment="Center" ToolTip="Ouvrir le fichier pour l'identifier (touche O)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="13"/>
                                            <TextBlock Text="Ouvrir" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" Margin="0,18,0,8">
                                    <WrapPanel x:Name="DocSorterTargets"/>
                                </ScrollViewer>
                                <Grid Margin="0,8,0,0">
                                    <Button x:Name="DocSorterBackButton" Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Click="DocSorterBack_Click" ToolTip="Retour arrière">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="13"/>
                                            <TextBlock Text="Annuler la dernière action" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BaseButton}" Click="DocSorterNewFolder_Click" Margin="0,0,10,0" ToolTip="Touche N">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8F4;" Style="{StaticResource Glyph}" FontSize="13"/>
                                                <TextBlock Text="Nouveau dossier…" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BaseButton}" Click="DocSorterRecycle_Click" Margin="0,0,10,0" ToolTip="Envoyer à la Corbeille (touche Suppr), récupérable ensuite">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13"/>
                                                <TextBlock Text="Corbeille" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BaseButton}" Click="DocSorterKeep_Click" Margin="0,0,10,0" ToolTip="Ne plus proposer ce fichier (touche G)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="13"/>
                                                <TextBlock Text="Garder sur le bureau" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BaseButton}" Click="DocSorterLater_Click" ToolTip="Touche Espace">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE893;" Style="{StaticResource Glyph}" FontSize="13"/>
                                                <TextBlock Text="Plus tard" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ======================= Saisie d'un nom ======================= -->
                    <!-- ======================= Gestionnaire d'applications ======================= -->
                    <Grid x:Name="ManagerOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D90B0B10" Panel.ZIndex="10">
                        <Border Width="860" Margin="0,40" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="30,24">
                            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="ManagerTitle" Text="Gérer les applications" Style="{StaticResource SectionTitle}" FontSize="20"/>
                                        <TextBlock Text="Le programme de désinstallation officiel de chaque éditeur est utilisé. Centre PC ne supprime aucun fichier lui-même."
                                                   Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="CloseManager_Click" ToolTip="Fermer (Échap)"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,18,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ManagerObsoleteChip" Style="{StaticResource Chip}" Checked="ManagerFilter_Changed">
                                            <TextBlock x:Name="ManagerObsoleteText" Text="Obsolètes"/>
                                        </RadioButton>
                                        <RadioButton x:Name="ManagerAllChip" Style="{StaticResource Chip}" Checked="ManagerFilter_Changed">
                                            <TextBlock x:Name="ManagerAllText" Text="Toutes"/>
                                        </RadioButton>
                                    </StackPanel>
                                    <TextBox x:Name="ManagerSearch" Grid.Column="1" Width="300" Style="{StaticResource SearchBox}" Tag="Rechercher une application"
                                             TextChanged="ManagerSearch_TextChanged"/>
                                </Grid>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl x:Name="ManagerList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Surface2}" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="34" Height="34">
                                                                <Border CornerRadius="9" Background="{Binding App.ThemeBrush}"
                                                                        Visibility="{Binding App.HasIcon, Converter={StaticResource InvBoolToVis}}">
                                                                    <TextBlock Text="{Binding App.Initial}" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Image Source="{Binding App.Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                                    <Border Background="#33F59E0B" CornerRadius="6" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                            Visibility="{Binding App.IsObsolete, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="Obsolète" Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Style="{StaticResource BaseButton}" Content="{Binding ActionText}" Tag="{Binding}"
                                                                    IsEnabled="{Binding CanAct}" Click="ManagerUninstall_Click" VerticalAlignment="Center" MinWidth="130"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="ManagerEmpty" Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <TextBlock x:Name="ManagerFooter" Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,220,0"/>
                                    <Button Style="{StaticResource BaseButton}" Content="Applications installées de Windows" Click="ManagerWindowsSettings_Click"
                                            HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ======================= Plan de rangement / vérification ======================= -->
                    <Grid x:Name="DocPlanOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D90B0B10" Panel.ZIndex="10">
                        <Border MaxWidth="1040" Margin="36,36" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="30,24">
                            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock x:Name="DocPlanOverlayTitle" Style="{StaticResource SectionTitle}" FontSize="20"/>
                                        <TextBlock x:Name="DocPlanOverlayText" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Click="DocPlanClose_Click" ToolTip="Fermer (Échap)"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                                <Border Grid.Row="1" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,14,0,6" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="14" Foreground="MediumSeaGreen" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="DocPlanReassurance" TextWrapping="Wrap" FontSize="12.5" MaxWidth="780" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer x:Name="DocPlanScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DocPlanList"/>
                                </ScrollViewer>
                                <!-- Rangement proposé : liste à gauche, origine → destination de l'élément choisi à droite -->
                                <Grid x:Name="DocPlanSplit" Grid.Row="2" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="330"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource Surface2}" CornerRadius="12" Padding="6">
                                        <ScrollViewer x:Name="DocPlanItemsScroll" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="DocPlanItems"/>
                                        </ScrollViewer>
                                    </Border>
                                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,0,0,0">
                                        <StackPanel x:Name="DocPlanDetail"/>
                                    </ScrollViewer>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <TextBlock x:Name="DocPlanSummary" Style="{StaticResource Subtle}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,380,0"/>
                                    <StackPanel x:Name="DocPlanButtons" Orientation="Horizontal" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Aperçu agrandi de l'élément affiché (clic, Espace ou Échap pour revenir) -->
                        <Grid x:Name="DocZoom" Visibility="Collapsed" Background="#F00B0B10" Cursor="Hand" MouseLeftButtonUp="DocZoom_Click">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="DocZoomGlyph" Style="{StaticResource Glyph}" FontSize="120" Opacity="0.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="DocZoomImage" Margin="48,40,48,12" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Rendu réel des documents (gestionnaire d'aperçu de Windows) et des textes -->
                            <Border x:Name="DocZoomHostBox" Margin="48,40,48,12" Visibility="Collapsed" Background="White"/>
                            <Border x:Name="DocZoomTextBox" Margin="48,40,48,12" Visibility="Collapsed" Background="{StaticResource Surface2}" CornerRadius="10">
                                <TextBox x:Name="DocZoomText" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource Text}" Padding="16" Cursor="IBeam" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Border>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <TextBlock x:Name="DocZoomName" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="900"/>
                                <TextBlock x:Name="DocZoomStatus" Style="{StaticResource Subtle}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#B9AAFF"/>
                                <!-- Retour : en bas, loin des boutons de la fenêtre (une croix en haut à droite se superposait à « Fermer ») -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Style="{StaticResource BaseButton}" Click="DocZoomClose_Click" Padding="14,5" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="12"/>
                                            <TextBlock Text="Revenir" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Text="Échap · flèches ↑ ↓ : élément précédent ou suivant"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Outil de test d'un périphérique -->
                    <Grid x:Name="DeviceTestOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D90B0B10" Panel.ZIndex="10">
                        <Border MaxWidth="1000" Margin="36,40" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="30,24">
                            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock x:Name="DeviceTestTitle" Style="{StaticResource SectionTitle}" FontSize="20" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource BaseButton}" HorizontalAlignment="Right" Click="DeviceTestClose_Click" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="11"/>
                                            <TextBlock Text="Terminer" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DeviceTestHost"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="PromptOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D90B0B10" Panel.ZIndex="20">
                        <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="26,22">
                            <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                            <StackPanel>
                                <TextBlock x:Name="PromptTitle" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="PromptHint" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                <TextBox x:Name="PromptBox" Style="{StaticResource SearchBox}" Tag="Nom" KeyDown="PromptBox_KeyDown"/>
                                <TextBlock x:Name="PromptError" Foreground="IndianRed" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button Style="{StaticResource BaseButton}" Content="Annuler" Click="PromptCancel_Click" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource AccentButton}" Content="Valider" Click="PromptOk_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Présentation (premier lancement) -->
        <Grid x:Name="WelcomeOverlay" Visibility="Collapsed" Background="#E6090910">
            <Border Width="900" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="40,34">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                        <Image Source="app.ico" Width="34" Height="34"/>
                    </Border>
                    <TextBlock Text="Bienvenue dans Centre PC" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" Margin="0,18,0,4"/>
                    <TextBlock Text="Votre PC centralisé en un seul endroit. Trois points essentiels :" Style="{StaticResource Subtle}" FontSize="14"/>
                    <UniformGrid Columns="3" Margin="-8,24,-8,0">
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" FontSize="24" HorizontalAlignment="Left" Foreground="#8B7CFF"/>
                                <TextBlock Text="1. Vos applications" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,6"/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Subtle}" Text="Elles sont classées automatiquement par catégorie. Saisissez un nom pour lancer une application."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="24" HorizontalAlignment="Left" Foreground="#3B82F6"/>
                                <TextBlock Text="2. Votre bureau" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,6"/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Subtle}" Text="« Ranger le bureau » le libère en un clic. L'état initial peut être rétabli à tout moment."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8">
                            <StackPanel>
                                <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="24" HorizontalAlignment="Left" Foreground="#10B981"/>
                                <TextBlock Text="3. Les mises à jour" FontWeight="SemiBold" FontSize="15" Margin="0,12,0,6"/>
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource Subtle}" Text="Centre PC vérifie automatiquement. Une pastille vous signale les mises à jour, installées ensuite en un clic."/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Button Style="{StaticResource AccentButton}" Content="Commencer" HorizontalAlignment="Right" Padding="28,12" Margin="0,24,0,0" Click="Welcome_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Nouveauté proposée une seule fois, au premier lancement qui suit son arrivée : l'accès rapide -->
        <Grid x:Name="QuickOfferOverlay" Visibility="Collapsed" Background="#E6090910">
            <Border Width="620" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="36,30">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="22" Foreground="White"/>
                        </Border>
                        <Border Background="#2D2560" CornerRadius="8" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Nouveau" FontSize="12" FontWeight="SemiBold" Foreground="#B9AAFF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Ouvrez vos applications en un instant" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <TextBlock x:Name="QuickOfferText" Style="{StaticResource Subtle}" FontSize="14" TextWrapping="Wrap"/>
                    <!-- Le raccourci, dessiné comme des touches -->
                    <WrapPanel x:Name="QuickOfferKeys" Margin="0,18,0,0"/>
                    <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource Subtle}" FontSize="12.5"
                                       Text="Discret : aucune fenêtre à gérer. Fermer Centre PC le garde disponible près de l'horloge ; clic droit sur l'icône › Quitter pour l'arrêter. Tout se règle ou se désactive dans Réglages › Accès rapide."/>
                            <CheckBox x:Name="QuickOfferStartup" IsChecked="True" Margin="0,10,0,0"
                                      Content="Disponible dès l'ouverture de session (sans fenêtre, seulement l'icône)"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource BaseButton}" Content="Non merci" Click="QuickOfferNo_Click" Padding="20,10" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource AccentButton}" Content="Activer l'accès rapide" Click="QuickOfferYes_Click" Padding="22,10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Nouvelle version de Centre PC -->
        <Grid x:Name="AppUpdateOverlay" Visibility="Collapsed" Background="#D9090910">
            <Border Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="34,30">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="20" Foreground="White"/>
                    </Border>
                    <TextBlock x:Name="AppUpdateTitle" Text="Une nouvelle version est disponible" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                               FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock x:Name="AppUpdateSubtitle" Style="{StaticResource Subtle}" FontSize="13.5"/>
                    <TextBlock x:Name="AppUpdateNotes" Style="{StaticResource Subtle}" TextWrapping="Wrap" MaxHeight="160" Margin="0,14,0,0"/>
                    <ProgressBar x:Name="AppUpdateProgress" Height="4" Margin="0,18,0,0" Visibility="Collapsed" Maximum="1"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource Surface2}" BorderThickness="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="AppUpdateLaterButton" Style="{StaticResource BaseButton}" Content="Plus tard" Click="AppUpdateLater_Click" Margin="0,0,10,0"/>
                        <Button x:Name="AppUpdateNowButton" Style="{StaticResource AccentButton}" Content="Mettre à jour maintenant" Click="AppUpdateNow_Click" Padding="20,11"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notification -->
        <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="240,0,0,30" Background="#2A2A36"
                BorderBrush="#3D3D4D" BorderThickness="1" CornerRadius="12" Padding="18,11" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14" Foreground="#8B7CFF"/>
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" FontSize="13.5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

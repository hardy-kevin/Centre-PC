                                                        <Button Grid.Column="2" Style="{StaticResource BaseButton}" Padding="12,5" Content="Modifier" Tag="{Binding Name}" Click="EditTheme_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

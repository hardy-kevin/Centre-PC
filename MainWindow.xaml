                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Mes choix enregistrés" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="ChoicesSummary" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="ResetChoicesButton" Style="{StaticResource BaseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ResetChoices_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE777;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                <TextBlock Text="Tout réinitialiser" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <ItemsControl x:Name="ChoicesList" Margin="0,12,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="260"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

<Window x:Class="CentrePC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CentrePC.Core"
        Title="Centre PC" Width="1300" Height="840" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        Icon="app.ico" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <core:InverseBoolToVisibility x:Key="InvBoolToVis"/>
        <core:ThemeGlyphConverter x:Key="ThemeGlyph"/>
        <core:ThemeBrushConverter x:Key="ThemeBrush"/>

        <!-- Tuile commune à toutes les pages -->
        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource TileButton}" Tag="{Binding}" ToolTip="{Binding Label}"
                    Click="Tile_Click" MouseRightButtonUp="Tile_RightClick" AllowDrop="True"
                    PreviewMouseLeftButtonDown="Tile_MouseDown" PreviewMouseMove="Tile_MouseMove"
                    DragEnter="Tile_DragEnter" DragOver="Tile_DragOver" DragLeave="Tile_DragLeave" Drop="Tile_Drop">
                <Grid Margin="8,14,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12" Background="{Binding ThemeBrush}"
                            Visibility="{Binding HasIcon, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="{Binding Initial}" FontSize="21" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="{Binding Icon}" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource Accent}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,-6,10,0" ToolTip="Toujours conservé sur le bureau"
                            Visibility="{Binding Keep, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="10" Foreground="White"/>
                    </Border>
                    <!-- Suite d'applications : nombre d'applications regroupées -->
                    <Border MinWidth="20" Height="20" CornerRadius="10" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,-2" Padding="5,0"
                            ToolTip="Suite : cliquez pour choisir l'application" Visibility="{Binding IsSuite, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding SuiteCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Application obsolète -->
                    <Border Width="20" Height="20" CornerRadius="10" Background="#F59E0B" HorizontalAlignment="Left"
                            VerticalAlignment="Top" Margin="10,-6,0,0" ToolTip="{Binding ObsoleteTip}"
                            Visibility="{Binding IsObsolete, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="10" Foreground="White"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding Label}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                               FontSize="12.5" MaxHeight="34" Margin="0,7,0,0" Foreground="{StaticResource Text}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="GroupTemplate">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,22,0,12">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{Binding Brush}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="White"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource Surface2}" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}" Foreground="{StaticResource Text2}" FontSize="12"/>
                    </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="Root">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============================ Barre latérale ============================ -->
                <Border x:Name="Sidebar" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="16,0,16,18">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,22,0,34">
                            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGradient}">
                                <Image Source="app.ico" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Centre PC" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Votre PC, centralisé" FontSize="11.5" Foreground="{StaticResource Text2}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,0" Cursor="Hand" MouseLeftButtonUp="Footer_Click" Background="Transparent"
                                    ToolTip="Version et mises à jour de Centre PC">
                            <Border x:Name="AppUpdateBadge" Visibility="Collapsed" Background="{StaticResource AccentGradient}" CornerRadius="8"
                                    Padding="10,5" Margin="0,0,8,10" HorizontalAlignment="Left">
                                <TextBlock x:Name="AppUpdateBadgeText" Text="Nouvelle version disponible" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="OnlineDot" Width="7" Height="7" Fill="MediumSeaGreen" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="FooterText" Text="Centre PC" FontSize="11.5" Foreground="{StaticResource Text2}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel>
                            <RadioButton x:Name="NavApps" Style="{StaticResource NavButton}" IsChecked="True" Checked="Nav_Checked" Tag="apps">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" FontSize="17" Width="22"/>
                                    <TextBlock Text="Applications" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDesktop" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="desktop">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="17" Width="22"/>
                                    <TextBlock Text="Bureau" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDocuments" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="documents">
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="17" Width="22"/>
                                        <TextBlock Text="Documents" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="DocsBadge" HorizontalAlignment="Right" Background="#F59E0B" CornerRadius="9"
                                            Padding="7,1" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Fichiers à ranger">
                                        <TextBlock x:Name="DocsBadgeText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavUpdates" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="updates">
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="17" Width="22"/>
                                        <TextBlock Text="Mises à jour" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="UpdatesBadge" HorizontalAlignment="Right" Background="{StaticResource AccentGradient}" CornerRadius="9"
                                            Padding="7,1" Visibility="Collapsed" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdatesBadgeText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavDevices" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="devices">
                                <Grid Width="170">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE772;" Style="{StaticResource Glyph}" FontSize="17" Width="22"/>
                                        <TextBlock Text="Périphériques" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border x:Name="DevicesBadge" HorizontalAlignment="Right" Background="#F59E0B" CornerRadius="9"
                                            Padding="7,1" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Points à vérifier sur vos périphériques">
                                        <TextBlock x:Name="DevicesBadgeText" Text="0" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="17" Width="22"/>
                                    <TextBlock Text="Réglages" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <!-- Outils rapides : actions immédiates (pas des pages) -->
                            <Border Height="1" Background="{StaticResource Line}" Margin="12,10,12,10"/>
                            <Button x:Name="NavScreenshot" Style="{StaticResource NavAction}" Click="Screenshot_Click"
                                    ToolTip="Clic : capturer une zone de l'écran · clic droit : écran entier, retardateur, dossier des captures">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE722;" Style="{StaticResource Glyph}" FontSize="17" Width="22"/>
                                    <TextBlock Text="Capture d'écran" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Fenêtre ouverte par-dessus : le menu est voilé, bloqué, et la raison est affichée -->
                <Border x:Name="SidebarShield" Visibility="Collapsed" Background="#D90B0B10" Cursor="No" Panel.ZIndex="5"
                        MouseLeftButtonDown="ModalBackdrop_Click">
                    <StackPanel VerticalAlignment="Center" Margin="26,0">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#24242E" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{StaticResource Text2}"/>
                        </Border>
                        <TextBlock Text="Menu en pause" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,0"/>
                        <TextBlock x:Name="SidebarShieldText" Foreground="{StaticResource Text2}" TextWrapping="Wrap" FontSize="12.5" Margin="0,4,0,0"
                                   Text="Terminez ou fermez la fenêtre ouverte pour revenir au menu (touche Échap)."/>
                    </StackPanel>
                </Border>

                <!-- ============================ Contenu ============================ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Boutons de la fenêtre -->
                    <!-- Toujours accessibles, même avec une fenêtre ouverte par-dessus (réduire, agrandir, fermer) -->
                    <StackPanel x:Name="WindowButtons" Panel.ZIndex="30" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" Click="Min_Click" ToolTip="Réduire"/>
                        <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Content="&#xE922;" Click="Max_Click" ToolTip="Agrandir"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer"/>
                    </StackPanel>

                    <!-- ======================= Page Applications ======================= -->
                    <Grid x:Name="PageApps" Grid.Row="1" Margin="40,0,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,12,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Applications" Style="{StaticResource PageTitle}"/>
                                <TextBlock x:Name="AppsSubtitle" Text="Chargement des applications…" Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <!-- Astuce sur sa propre ligne (elle était coupée par les boutons de droite) -->
                                <StackPanel x:Name="AppsTip" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                                    <TextBlock Text="&#xE82F;" Style="{StaticResource Glyph}" FontSize="12" Foreground="#F5B83D" VerticalAlignment="Center"/>
                                    <TextBlock Text="Astuce : glissez une tuile sur une autre pour les regrouper" Style="{StaticResource Subtle}" FontSize="12.5"
                                               Margin="6,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OnlineButton" Style="{StaticResource BaseButton}" Click="Online_Click" Margin="0,0,12,0" Height="46" Visibility="Collapsed"
                                        ToolTip="Identifie les applications de la catégorie « Autres » grâce aux catalogues publics (winget, Steam, Google Play, Wikidata…). Seul le nom de l'application est transmis.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="14"/>
                                        <TextBlock x:Name="OnlineButtonText" Text="Affiner le classement en ligne" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BaseButton}" Click="OpenManager_Click" Margin="0,0,12,0" Height="46"
                                        ToolTip="Désinstaller des applications et repérer celles qui sont obsolètes">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE912;" Style="{StaticResource Glyph}" FontSize="14"/>
                                        <TextBlock Text="Gérer les applications" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="SearchBox" Width="380" VerticalAlignment="Center" Style="{StaticResource SearchBox}"
                                         Tag="Rechercher… (saisissez directement)" TextChanged="Search_TextChanged" PreviewKeyDown="Search_KeyDown"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="ChipsHost" Grid.Row="1" Margin="0,0,12,4"/>
                        <ScrollViewer x:Name="AppsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,24">
                            <StackPanel>
                                <Border x:Name="SortBanner" Visibility="Collapsed" Background="{StaticResource HeroGradient}" CornerRadius="14"
                                        BorderBrush="#3A2F7A" BorderThickness="1" Padding="20,14" Margin="0,8,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradient}">
                                            <TextBlock x:Name="SortBannerGlyph" Text="&#xE8CB;" Style="{StaticResource Glyph}" FontSize="15" Foreground="White"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SortBannerTitle" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock x:Name="SortBannerText" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="SortBannerButton" Grid.Column="2" Style="{StaticResource AccentButton}" Content="Trier maintenant" Click="OpenSorter_Click"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="ObsoleteBanner" Visibility="Collapsed" Background="{StaticResource Surface}" CornerRadius="14"
                                        BorderBrush="#7A5A1F" BorderThickness="1" Padding="20,14" Margin="0,8,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#F59E0B">
                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="15" Foreground="White"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ObsoleteBannerTitle" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock x:Name="ObsoleteBannerText" Style="{StaticResource Subtle}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource BaseButton}" Content="Plus tard" Click="ObsoleteLater_Click" Margin="0,0,10,0"/>
                                            <Button Style="{StaticResource AccentButton}" Content="Voir" Click="OpenObsolete_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <StackPanel x:Name="FavSection" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="2,22,0,12">
                                        <Border Width="30" Height="30" CornerRadius="9" Background="#F5B83D">
                                            <TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="14" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="Favoris" Style="{StaticResource SectionTitle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="FavList" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                                </StackPanel>
                                <ItemsControl x:Name="AppsList" ItemTemplate="{StaticResource GroupTemplate}"/>
                                <StackPanel x:Name="AppsEmpty" Visibility="Collapsed" Margin="0,60,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{StaticResource Text2}"/>
                                    <TextBlock Text="Aucune application ne correspond à votre recherche" Style="{StaticResource Subtle}" FontSize="15" Margin="0,14,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======================= Page Bureau ======================= -->
                    <ScrollViewer x:Name="PageDesktop" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,0,40,28">
                        <StackPanel>
                            <TextBlock Text="Bureau" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="DeskHint" Text="Rangez votre bureau en un clic. Vous pouvez rétablir l'état initial à tout moment." Style="{StaticResource Subtle}" Margin="0,4,0,20"/>

                            <Border Background="{StaticResource HeroGradient}" CornerRadius="18" Padding="30,26" BorderBrush="#3A2F7A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel>
                                                <TextBlock x:Name="DeskCount" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold"/>
                                                <TextBlock Text="sur le bureau" Style="{StaticResource Subtle}"/>
                                            </StackPanel>
                                            <Border Width="1" Background="#33FFFFFF" Margin="32,6"/>
                                            <StackPanel>
                                                <TextBlock x:Name="StoredCount" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="StoredLabel" Text="rangées dans Centre PC" Style="{StaticResource Subtle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="270">
                                        <Button Style="{StaticResource AccentButton}" Click="Tidy_Click" Padding="18,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="15"/>
                                                <TextBlock Text="Ranger le bureau" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BaseButton}" Click="RestoreAll_Click" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                <TextBlock Text="Tout remettre sur le bureau" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>


                            <!-- Organisation du bureau : options regroupées ici, repliées par défaut -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="15"/>
                                            <TextBlock Text="Organisation du bureau" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="DeskOptionsSummary" Style="{StaticResource Subtle}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Button x:Name="DeskOptionsToggle" Style="{StaticResource BaseButton}" Content="Personnaliser" Padding="14,7"
                                                HorizontalAlignment="Right" Click="DeskOptionsToggle_Click"/>
                                    </Grid>
                                    <StackPanel x:Name="DeskOptionsPanel" Visibility="Collapsed" Margin="0,18,0,4">
                                        <TextBlock Text="EMPLACEMENT DES ICÔNES RANGÉES" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <RadioButton x:Name="ModeAppRadio" Style="{StaticResource Chip}" GroupName="tidymode" Checked="TidyMode_Checked" Tag="app">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" FontSize="12"/>
                                                    <TextBlock Text="Dans Centre PC (bureau vide)" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ModeFoldersRadio" Style="{StaticResource Chip}" GroupName="tidymode" Checked="TidyMode_Checked" Tag="folders">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="12"/>
                                                    <TextBlock Text="Dans des dossiers de catégorie sur le bureau" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </WrapPanel>
                                        <CheckBox x:Name="TidyFilesCheck" Content="Proposer de ranger les fichiers du bureau dans Documents, Images…" Margin="0,12,0,0"
                                                  Checked="TidyFiles_Changed" Unchecked="TidyFiles_Changed"/>
                                        <CheckBox x:Name="ArrowsCheck" Content="Masquer les flèches de raccourci" Margin="0,8,0,0" Click="Arrows_Click"/>

                                        <!-- Apparence : utile surtout avec les dossiers de catégorie sur le bureau -->
                                        <StackPanel x:Name="StyleSection" Margin="0,22,0,0">
                                            <TextBlock Text="APPARENCE DES ICÔNES" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="StyleIntro" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                                            <CheckBox x:Name="StyleFoldersCheck" Content="Colorer aussi les dossiers du bureau" Margin="0,10,0,0"
                                                      Checked="StyleFolders_Changed" Unchecked="StyleFolders_Changed"/>
                                            <WrapPanel Margin="0,14,0,0">
                                                <Button x:Name="PreviewButton" Style="{StaticResource BaseButton}" Click="Preview_Click" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE890;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                        <TextBlock Text="Aperçu" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="ApplyStyleButton" Style="{StaticResource AccentButton}" Click="ApplyStyle_Click" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                        <TextBlock Text="Appliquer" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="RevertStyleButton" Style="{StaticResource BaseButton}" Click="RevertStyle_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                        <TextBlock Text="Icônes d'origine" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                            <TextBlock x:Name="StyleStatus" Style="{StaticResource Subtle}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            <Border x:Name="PreviewPanel" Visibility="Collapsed" Background="{StaticResource DesktopGradient}" CornerRadius="14"
                                                    Padding="20,18,10,8" Margin="0,18,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="APERÇU DU BUREAU" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                                    <ItemsControl x:Name="PreviewList" ItemsPanel="{StaticResource WrapPanelTemplate}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Width="92" Margin="0,0,8,14">
                                                                    <Image Source="{Binding Image}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                                                               TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,6,0,0">
                                                                        <TextBlock.Effect>
                                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.8"/>
                                                                        </TextBlock.Effect>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Button x:Name="OpenStoreButton" Style="{StaticResource BaseButton}" Click="OpenStore_Click" Margin="0,20,0,0" HorizontalAlignment="Left" Padding="12,6"
                                                ToolTip="Dossier où Centre PC conserve les raccourcis rangés">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13"/>
                                                <TextBlock Text="Ouvrir le dossier des raccourcis rangés" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="LegacyBanner" Visibility="Collapsed"><TextBlock x:Name="LegacyText"/></Border>
                            <StackPanel Orientation="Horizontal" Margin="2,28,0,12">
                                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentGradient}">
                                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="14" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Sur le bureau" Style="{StaticResource SectionTitle}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clic droit sur une icône pour la conserver ou la ranger" Style="{StaticResource Subtle}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Background="{StaticResource DesktopGradient}" CornerRadius="16" Padding="16,16,8,8" MinHeight="130" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                <Grid>
                                    <ItemsControl x:Name="DeskList" ItemTemplate="{StaticResource TileTemplate}" ItemsPanel="{StaticResource WrapPanelTemplate}"/>
                                    <TextBlock x:Name="DeskEmpty" Text="Votre bureau est rangé." Style="{StaticResource Subtle}" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="StoredList" ItemTemplate="{StaticResource GroupTemplate}" Margin="0,6,0,0"/>

                            <!-- Historique : chaque déplacement peut être annulé pendant 30 jours -->
                            <StackPanel x:Name="HistoryBox" Visibility="Collapsed" Margin="0,22,0,0">
                                <Grid Margin="2,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Historique" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="30 derniers jours : « Annuler » rétablit l'élément à son emplacement précédent" Style="{StaticResource Subtle}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="HistoryMoreButton" Style="{StaticResource BaseButton}" Content="Tout afficher" Padding="12,6" HorizontalAlignment="Right" Click="HistoryMore_Click"/>
                                </Grid>
                                <Border Style="{StaticResource Card}" Padding="10,4">
                                    <ItemsControl x:Name="HistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="6,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="12"/>
                                                                <TextBlock Text=" · " Style="{StaticResource Subtle}" FontSize="12"/>
                                                                <TextBlock Text="{Binding When}" Style="{StaticResource Subtle}" FontSize="12"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="Annuler" Padding="12,5" Tag="{Binding}"
                                                                IsEnabled="{Binding CanUndo, Mode=OneTime}" Click="HistoryUndo_Click" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================= Page Documents ======================= -->
                    <ScrollViewer x:Name="PageDocuments" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,0,40,28">
                        <StackPanel>
                            <TextBlock Text="Documents" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Vos fichiers sont classés dans les dossiers Windows (Documents, Images, Musique, Vidéos) et dans vos propres sous-dossiers. Ils y restent même sans Centre PC."
                                       Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,20"/>

                            <Border Background="{StaticResource HeroGradient}" CornerRadius="18" Padding="26,18" BorderBrush="#3A2F7A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <!-- Chiffre et libellé sur une ligne : « 12 éléments à ranger » -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="DocPendingCount" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                                            <TextBlock x:Name="DocPendingLabel" Text="éléments à ranger" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,6" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DocPendingDetail" Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="270">
                                        <Button x:Name="DocSortButton" Style="{StaticResource AccentButton}" Click="DocSort_Click" Padding="18,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="15"/>
                                                <TextBlock Text="Ranger mes fichiers" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BaseButton}" Click="DocAddExisting_Click" Margin="0,10,0,0"
                                                ToolTip="Ajouter à l'arborescence un dossier existant de votre PC">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                <TextBlock Text="Ajouter un dossier existant" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Vérification des rangements effectués (réversibles) -->
                            <Border x:Name="DocReviewCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed" BorderBrush="#3A2F7A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="DocReviewTitle" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Validez ce qui vous convient. « Remettre à sa place » annule le déplacement : l'élément retrouve son emplacement d'origine et ne vous sera plus proposé."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Style="{StaticResource BaseButton}" Content="Tout valider" Click="DocReviewAcceptAll_Click" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource AccentButton}" Content="Vérifier" Click="DocReviewOpen_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Plan de rangement : arborescence proposée et rangement des éléments non rangés -->
                            <Border x:Name="DocPlanCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="DocPlanTitle" Text="Votre plan de rangement" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="DocPlanText" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="13" Foreground="MediumSeaGreen" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                        <TextBlock Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" MaxWidth="820"
                                                   Text="Rangement réversible : rien n'est supprimé ni renommé. Chaque élément peut être remis à sa place, tout de suite ou plus tard. Vos dossiers existants sont conservés et réutilisés."/>
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button x:Name="DocPlanButton" Style="{StaticResource AccentButton}" Click="DocPlanOpen_Click" Margin="0,0,10,0" Content="Voir le plan"/>
                                        <Button Style="{StaticResource BaseButton}" Click="DocPlanLater_Click" Content="Plus tard"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="DocTreePanel" Margin="0,6,0,0"/>

                            <StackPanel x:Name="DocRecentBox" Visibility="Collapsed" Margin="0,22,0,0">
                                <TextBlock Text="Rangés récemment" Style="{StaticResource SectionTitle}" Margin="2,0,0,10"/>
                                <Border Style="{StaticResource Card}" Padding="8">
                                    <StackPanel x:Name="DocRecentPanel"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================= Page Mises à jour ======================= -->
                    <ScrollViewer x:Name="PageUpdates" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,0,40,28">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mises à jour" Style="{StaticResource PageTitle}"/>
                                    <TextBlock x:Name="LastCheckText" Text="Jamais vérifié" Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource AccentButton}" Click="Scan_Click" Padding="18,12" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="14"/>
                                        <TextBlock x:Name="ScanButtonText" Text="Rechercher les mises à jour" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border x:Name="OfflineBanner" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="#7A5A1F">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="18" Foreground="#F5B83D"/>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="Pas de connexion internet" FontWeight="SemiBold"/>
                                        <TextBlock Text="La recherche et l'installation des mises à jour reprendront dès le retour de la connexion. Les autres fonctions de Centre PC restent disponibles."
                                                   Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Résumé -->
                            <UniformGrid Columns="3" Margin="-6,0">
                                <Border Style="{StaticResource Card}" Margin="6">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#3B82F6" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE71D;" Style="{StaticResource Glyph}" FontSize="15" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="Applications" Style="{StaticResource Subtle}" Margin="0,14,0,0"/>
                                        <TextBlock x:Name="SumApps" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SumAppsSub" Text="à vérifier" Style="{StaticResource Subtle}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#10B981" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="15" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="Windows Update" Style="{StaticResource Subtle}" Margin="0,14,0,0"/>
                                        <TextBlock x:Name="SumWu" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SumWuSub" Text="à vérifier" Style="{StaticResource Subtle}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#8B5CF6" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE772;" Style="{StaticResource Glyph}" FontSize="15" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="Pilotes" Style="{StaticResource Subtle}" Margin="0,14,0,0"/>
                                        <TextBlock x:Name="SumDrivers" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SumDriversSub" Text="à vérifier" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#EF4444" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="15" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="Pilote graphique" Style="{StaticResource Subtle}" Margin="0,14,0,0"/>
                                        <TextBlock x:Name="SumGpu" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SumGpuSub" Text="" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6" Visibility="Collapsed">
                                    <StackPanel>
                                        <Border Width="34" Height="34" CornerRadius="10" Background="#F59E0B" HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE964;" Style="{StaticResource Glyph}" FontSize="15" Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="BIOS" Style="{StaticResource Subtle}" Margin="0,14,0,0"/>
                                        <TextBlock x:Name="SumBios" Text="–" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SumBiosSub" Text="" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Installation -->
                            <Border x:Name="InstallCard" Style="{StaticResource Card}" Margin="0,6,0,16" BorderBrush="#3A2F7A">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Tout mettre à jour" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Applications, Windows, pilotes, Microsoft Store et antivirus en une seule opération. Options dans Réglages." Style="{StaticResource Subtle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="InstallButton" Grid.Column="1" Style="{StaticResource AccentButton}" Click="Install_Click" Padding="22,13" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="15"/>
                                                <TextBlock Text="Tout mettre à jour" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <StackPanel x:Name="InstallPanel" Visibility="Collapsed" Margin="0,18,0,0">
                                        <!-- Où en est-on ? -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="InstallHeadline" Text="Préparation…" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="InstallCounter" Grid.Column="1" Text="" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                        <ProgressBar x:Name="InstallProgress" Height="6" Minimum="0" Maximum="1" Value="0" Foreground="{StaticResource Accent}"
                                                     Background="{StaticResource Surface2}" BorderThickness="0" Margin="0,0,0,16"/>

                                        <!-- Rapport (affiché à la fin) -->
                                        <Border x:Name="ReportCard" Visibility="Collapsed" Background="{StaticResource Surface2}" CornerRadius="12" Padding="18,16" Margin="0,0,0,18">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="ReportGlyph" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="18" Foreground="MediumSeaGreen" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ReportTitle" Text="Rapport" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="ReportSummary" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <WrapPanel x:Name="ReportCounts" Margin="0,12,0,0"/>
                                                <StackPanel x:Name="ReportActionsBox" Visibility="Collapsed" Margin="0,16,0,0">
                                                    <TextBlock Text="Actions requises" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <ItemsControl x:Name="ReportActionsList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="30"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="15" Foreground="Goldenrod" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                            <Button Style="{StaticResource AccentButton}" Content="Lancer l'installateur" Padding="12,6" Tag="{Binding Installer}"
                                                                                    Visibility="{Binding InstallerVisibility}" Click="ReportLaunch_Click" Margin="0,0,8,0"/>
                                                                            <Button Style="{StaticResource BaseButton}" Content="Ne plus proposer" Padding="12,6" Tag="{Binding Id}" Visibility="{Binding ExcludeVisibility}"
                                                                                    ToolTip="Exclure cette application des mises à jour (réversible dans Réglages)" Click="ReportExclude_Click"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock x:Name="ReportDesktop" Visibility="Collapsed" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="ÉTAPES" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ItemsControl x:Name="StepsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Foreground="{Binding StatusBrush}" HorizontalAlignment="Left"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Subtle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel x:Name="AppsProgressBox" Visibility="Collapsed" Margin="0,14,0,0">
                                            <TextBlock Text="APPLICATIONS" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ItemsControl x:Name="AppsProgressList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Foreground="{Binding StatusBrush}" HorizontalAlignment="Left"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource Subtle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel x:Name="DriversProgressBox" Visibility="Collapsed" Margin="0,14,0,0">
                                            <TextBlock Text="PILOTES" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ItemsControl x:Name="DriversProgressList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Foreground="{Binding StatusBrush}" HorizontalAlignment="Left"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource Subtle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <Border x:Name="RebootBanner" Visibility="Collapsed" Background="#2D2650" CornerRadius="10" Padding="16,12" Margin="0,14,0,0">
                                            <Grid>
                                                <TextBlock Text="Un redémarrage est nécessaire pour terminer l'installation." VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource AccentButton}" Content="Redémarrer maintenant" HorizontalAlignment="Right" Click="Reboot_Click"/>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="LogToggle" Style="{StaticResource BaseButton}" Content="Afficher les détails" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,6" Click="LogToggle_Click"/>
                                        <TextBox x:Name="LogBox" Visibility="Collapsed" IsReadOnly="True" Height="220" Margin="0,10,0,0" Padding="12" FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="12" Background="#0E0E13" Foreground="#B9B9C9" BorderBrush="{StaticResource Line}"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Listes -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Applications" Style="{StaticResource SectionTitle}"/>

                                        </Button>
                                        <Button Style="{StaticResource BaseButton}" Content="Voir les versions" Click="OpenRepo_Click"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="AutoAppUpdateCheck" Content="Vérifier automatiquement au démarrage" Margin="0,12,0,0"

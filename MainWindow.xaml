                                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource Text2}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource BaseButton}" Padding="12,5" Content="Annuler" Tag="{Binding}" Click="UndoChoice_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ChoicesEmpty" Text="Aucun choix manuel : le classement est entièrement automatique." Style="{StaticResource Subtle}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="MISES À JOUR" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="2,26,0,0"/>
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Contenu de « Tout mettre à jour »" Style="{StaticResource SectionTitle}"/>
                                            <WrapPanel Margin="0,14,0,0">
                                                <CheckBox x:Name="OptApps" Content="Applications cochées" IsChecked="True" Margin="0,0,22,8"/>
                                                <CheckBox x:Name="OptWu" Content="Windows Update (système)" IsChecked="True" Margin="0,0,22,8"/>
                                                <CheckBox x:Name="OptDrivers" Content="Pilotes cochés" IsChecked="True" Margin="0,0,22,8"/>
                                                <CheckBox x:Name="OptStore" Content="Microsoft Store" IsChecked="True" Margin="0,0,22,8"/>
                                                <CheckBox x:Name="OptDefender" Content="Antivirus Defender" IsChecked="True" Margin="0,0,22,8"/>
                                                <CheckBox x:Name="OptRestore" Content="Point de restauration préalable" IsChecked="True" Margin="0,0,22,8"/>
                                            </WrapPanel>
                                    <Grid Margin="0,8,0,0">
                                        <CheckBox x:Name="DailyCheckBox" VerticalAlignment="Center" Checked="DailyCheck_Changed" Unchecked="DailyCheck_Changed">
                                            <TextBlock TextWrapping="Wrap" Text="Vérifier chaque jour, même lorsque Centre PC est fermé, et m'avertir par une notification (aucune installation sans votre accord)"/>
                                        </CheckBox>
                                        <Button x:Name="TestNotifButton" Style="{StaticResource BaseButton}" Content="Tester la notification" Padding="12,6"
                                                HorizontalAlignment="Right" Click="TestNotif_Click"/>
                                    </Grid>
                                    <TextBlock Text="Mises à jour exclues" FontWeight="SemiBold" Margin="0,12,0,4"/>
                                    <ItemsControl x:Name="ExclusionsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"/>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="12"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="Proposer à nouveau" Padding="12,6"
                                                                Tag="{Binding}" Click="RestoreExclusion_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ExclusionsEmpty" Text="Aucune : toutes les mises à jour sont proposées." Style="{StaticResource Subtle}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ACCÈS RAPIDE" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="2,26,0,0"/>
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Margin="0,0,170,0">
                                            <TextBlock Text="Lanceur d'applications" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="Un petit panneau s'ouvre depuis l'icône près de l'horloge ou un raccourci clavier : tapez un nom, l'application s'ouvre et le panneau disparaît. Fermer la fenêtre de Centre PC le garde disponible ; clic droit sur l'icône › Quitter pour l'arrêter."/>
                                        </StackPanel>
                                        <Button Style="{StaticResource BaseButton}" Content="Essayer" Click="QuickTry_Click" Padding="14,6"
                                                HorizontalAlignment="Right" VerticalAlignment="Top" IsEnabled="{Binding IsChecked, ElementName=QuickAccessCheck}"/>
                                    </Grid>
                                    <CheckBox x:Name="QuickAccessCheck" Margin="0,14,0,0" Checked="QuickAccess_Changed" Unchecked="QuickAccess_Changed"
                                              Content="Activer l'accès rapide (icône près de l'horloge et raccourci clavier)"/>
                                    <StackPanel x:Name="QuickOptions" Margin="30,12,0,0">
                                        <TextBlock Text="Raccourci clavier" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <StackPanel x:Name="QuickHotkeys"/>
                                        <CheckBox x:Name="StartWithWindowsCheck" Margin="0,6,0,0" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed">
                                            <TextBlock TextWrapping="Wrap" Text="Disponible dès l'ouverture de session (aucune fenêtre ne s'ouvre, seulement l'icône près de l'horloge)"/>
                                        </CheckBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="CENTRE PC" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="2,26,0,0"/>
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Version et assistance" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="AppVersionText" FontSize="14" Margin="0,8,0,2"/>
                                    <TextBlock x:Name="AppUpdateStatus" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="AppUpdateButton" Style="{StaticResource AccentButton}" Click="AppUpdate_Click" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="13"/>
                                                <TextBlock x:Name="AppUpdateButtonText" Text="Rechercher une mise à jour" Margin="8,0,0,0"/>

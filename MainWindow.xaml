                                                  Checked="AllDrivers_Changed" Unchecked="AllDrivers_Changed" Foreground="{StaticResource Text2}"/>
                                    </Grid>
                                    <TextBlock Text="Pilotes proposés par Windows Update pour vos périphériques. Un point de restauration est créé avant l'installation."
                                               Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <ItemsControl x:Name="DriverList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtle}" FontSize="12"/>
                                                                    <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" Foreground="Goldenrod" FontSize="12" Margin="10,0,0,0"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Subtle}" FontSize="12" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding Size}" Style="{StaticResource Subtle}" FontSize="11" HorizontalAlignment="Right" Opacity="0.7"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Tag="{Binding}" Click="ExcludeDriver_Click"
                                                                ToolTip="Ne plus proposer ce pilote (réversible dans Réglages)" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="DriversEmpty" Text="Lancez une recherche pour afficher les pilotes à mettre à jour." Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Matériel -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Matériel" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="CARTE GRAPHIQUE" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold"/>
                                            <StackPanel x:Name="GpuInfo" Margin="0,8,0,12"/>
                                            <Button x:Name="GpuToolButton" Style="{StaticResource BaseButton}" Content="Logiciel de la carte graphique" Click="OpenGpuTool_Click" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="BoardTitle" Text="CARTE MÈRE ET BIOS" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold"/>
                                            <StackPanel x:Name="BoardInfo" Margin="0,8,0,12"/>
                                            <Button x:Name="BiosButton" Style="{StaticResource BaseButton}" Content="Chercher une mise à jour du BIOS" Click="Bios_Click" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="PÉRIPHÉRIQUES ET OUTILS" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold"/>
                                            <StackPanel x:Name="PeriphInfo" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Le BIOS n'est jamais mis à jour automatiquement : une erreur pourrait rendre le PC inutilisable. Les firmwares des souris, claviers et casques se mettent à jour depuis le logiciel du fabricant."
                                               Style="{StaticResource Subtle}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ======================= Page Réglages ======================= -->
                    <!-- ======================= Page Périphériques ======================= -->
                    <ScrollViewer x:Name="PageDevices" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,0,40,28">
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Périphériques" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="L'état de vos périphériques et un premier diagnostic. Pour aller plus loin : les paramètres de Windows ou le logiciel du fabricant."/>
                                </StackPanel>
                                <Button x:Name="DevicesScanButton" Grid.Column="1" Style="{StaticResource BaseButton}" Click="DevicesScan_Click" Padding="16,10" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13"/>
                                        <TextBlock Text="Analyser à nouveau" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Background="{StaticResource HeroGradient}" CornerRadius="18" Padding="24,18" BorderBrush="#3A2F7A" BorderThickness="1" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="DevicesSummaryIcon" Width="44" Height="44" CornerRadius="13" Background="#10B981">
                                        <TextBlock x:Name="DevicesSummaryGlyph" Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="20" Foreground="White"/>
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DevicesSummaryTitle" Text="Analyse des périphériques…" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DevicesSummaryText" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Outils de test : on vérifie soi-même, en direct -->
                            <TextBlock Text="OUTILS DE TEST" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,10"/>
                            <WrapPanel x:Name="DeviceTestTiles" Margin="0,0,0,14"/>
                            <TextBlock Text="ÉTAT DES PÉRIPHÉRIQUES" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,10"/>
                            <StackPanel x:Name="DevicesPanel"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="40,0,40,28">
                        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
                            <TextBlock Text="Réglages" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="L'ensemble des paramètres de Centre PC." Style="{StaticResource Subtle}" Margin="0,4,0,20"/>


                            <TextBlock Text="CLASSEMENT DES APPLICATIONS" Foreground="{StaticResource Text2}" FontSize="11" FontWeight="SemiBold" Margin="2,8,0,0"/>
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Tri automatique" Style="{StaticResource SectionTitle}"/>

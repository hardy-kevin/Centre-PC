                                        <TextBlock TextWrapping="Wrap" Text="Identifier automatiquement en ligne les applications inconnues (seul le nom de l'application est transmis aux catalogues publics : winget, Steam, Google Play, Wikidata…)"/>
                                    </CheckBox>
                                    <TextBlock x:Name="OnlineSummary" Style="{StaticResource Subtle}" Margin="30,6,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button x:Name="SortUnsortedButton" Style="{StaticResource AccentButton}" Click="OpenSorterAll_Click" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8CB;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                <TextBlock x:Name="SortUnsortedText" Text="Trier les applications non classées" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RetryOnlineButton" Style="{StaticResource BaseButton}" Click="RetryOnline_Click" Margin="0,0,10,10"
                                                ToolTip="Interroge à nouveau les catalogues publics pour les applications de la catégorie « Autres »">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                <TextBlock Text="Relancer la recherche en ligne" Margin="10,0,0,0"/>

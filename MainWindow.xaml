                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Pilotes -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Pilotes" Style="{StaticResource SectionTitle}"/>

                                        <Button Style="{StaticResource BaseButton}" Click="ExportConfig_Click" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEDE1;" Style="{StaticResource Glyph}" FontSize="13"/>
                                                <TextBlock Text="Exporter la configuration" Margin="8,0,0,0"/>

                                                <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14"/>
                                                <TextBlock Text="Vérifier le tri automatique" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
